# ====================================================================
#  PALERMOCRAFT — .env для cPanel
#  1) Перейменуй цей файл на .env (у Файловому менеджері cPanel).
#  2) Заповни DB_*, UPDATE_KEY і (за бажанням) ключі Discord/Telegram/MineSkin.
#  3) Відкрий https://palermocraft.com/update.php → «Лише база і кеш».
#     APP_KEY згенерується сам, таблиці створяться.
#  Після КОЖНОЇ правки цього файлу знову натискай «Лише база і кеш» (скидає кеш конфігу).
# ====================================================================

APP_NAME=PALERMOCRAFT
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://palermocraft.com

APP_LOCALE=uk
APP_FAKER_LOCALE=uk_UA

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# База MySQL з cPanel → «MySQL® Databases». Ім'я і користувач мають префікс акаунта, напр. cpuser_palermo
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# На cPanel немає фонових воркерів, тож черга синхронна
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@palermocraft.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------- ОНОВЛЕННЯ (public/update.php) ----------------
# Пароль сторінки оновлення, мінімум 16 символів. Порожньо = сторінка вимкнена.
# Придумай довгий випадковий, напр. 40 символів з генератора паролів.
UPDATE_KEY=
# Звідки брати збірки для кнопки «Оновити з GitHub»
UPDATE_GITHUB_REPO=NemezXYAZI/palermocraftwebsite
# Потрібен лише якщо репозиторій стане приватним (fine-grained token з доступом Contents: Read)
UPDATE_GITHUB_TOKEN=

# ---------------- PALERMOCRAFT ----------------
# Адреса сервера Minecraft для гравців (напр. mc.palermocraft.com).
# Порожньо — на сайті «адресу оголосимо перед стартом сезону», онлайн не перевіряється.
PALERMO_GAME_ADDRESS=
PALERMO_GAME_VERSION=1.21.4
# Спільнота (необовʼязково): https://discord.gg/... і https://t.me/...
PALERMO_DISCORD_INVITE=
PALERMO_TELEGRAM_URL=
# Спільний секрет із плагіном PalermoSkins (config.yml → website.token і http.token)
PALERMO_GAME_API_TOKEN=
# Необов'язково: http://IP_СЕРВЕРА:8085 — миттєве оновлення скіна в грі
PALERMO_GAME_WEBHOOK_URL=
PALERMO_SKINS_REQUIRE_APPROVAL=true

MINESKIN_API_KEY=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI="${APP_URL}/auth/discord/callback"
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
